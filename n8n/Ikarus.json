    {
      "parameters": {
        "jsCode": "const unansweredItems = $('Unanswered').all();\nconst unreviewedItems = $('Unreviewed').all();\n\nconst teamId = 'T0B6XLLPR';\nconst defaultQuestionChannel = 'C0A8GHWST44';\nconst defaultCodeReviewChannel = 'C0B344CNJ7P';\n\nlet questionLines = [];\nif (!unansweredItems || unansweredItems.length === 0) {\n  questionLines.push(\"✅ *All questions answered!*\");\n} else {\n  questionLines = unansweredItems.map((item) => {\n    const channel = item.json.channel || item.json.channel_id || defaultQuestionChannel;\n    const ts = item.json.ts;\n    const user = item.json.user ? `<@${item.json.user}>` : 'User';\n    let link = item.json.permalink;\n\n    if (ts) {\n      link = `https://app.slack.com/client/${teamId}/${channel}/${ts}`;\n    }\n\n    return `• ${user} ➔ <${link}|View message>`;\n  });\n}\n\nlet codeReviewLines = [];\nif (!unreviewedItems || unreviewedItems.length === 0) {\n  codeReviewLines.push(\"✅ *All code reviews completed!*\");\n} else {\n  codeReviewLines = unreviewedItems.map((item) => {\n    const channel = item.json.channel || item.json.channel_id || defaultCodeReviewChannel;\n    const ts = item.json.ts;\n    const rawText = item.json.text || '';\n\n    let mrLink = '';\n    if (item.json.attachments && item.json.attachments[0] && item.json.attachments[0].original_url) {\n      mrLink = item.json.attachments[0].original_url;\n    } else {\n      const mrMatch = rawText.match(/<(https:\\/\\/gitlab[^|>]+)/);\n      mrLink = mrMatch ? mrMatch[1] : '';\n    }\n\n    const userMatch = rawText.match(/<@([A-Z0-9]+)>/);\n    const user = userMatch ? `<@${userMatch[1]}>` : 'Developer';\n\n    let slackLink = item.json.permalink;\n    if (ts) {\n      slackLink = `https://app.slack.com/client/${teamId}/${channel}/${ts}`;\n    }\n\n    const gitlabPart = mrLink ? `<${mrLink}|GitLab MR>` : 'MR Details';\n    const slackPart = slackLink ? `<${slackLink}|Slack link>` : '';\n\n    return `• ${user} ➔ ${gitlabPart} (${slackPart})`;\n  });\n}\n\nconst blocks = [\n  {\n    \"type\": \"header\",\n    \"text\": { \"type\": \"plain_text\", \"text\": \"🚀 DEV Standup: Task Overview\", \"emoji\": true }\n  },\n  {\n    \"type\": \"section\",\n    \"text\": { \"type\": \"mrkdwn\", \"text\": \"*Pending items without :white_check_mark:*\" }\n  },\n  { \"type\": \"divider\" },\n  {\n    \"type\": \"section\",\n    \"text\": { \"type\": \"mrkdwn\", \"text\": \"❓ *Unanswered Questions:*\" }\n  }\n];\n\nconst chunkSize = 15;\nfor (let i = 0; i < questionLines.length; i += chunkSize) {\n  const chunkText = questionLines.slice(i, i + chunkSize).join('\\n');\n  blocks.push({\n    \"type\": \"section\",\n    \"text\": { \"type\": \"mrkdwn\", \"text\": chunkText }\n  });\n}\n\nblocks.push(\n  { \"type\": \"divider\" },\n  {\n    \"type\": \"section\",\n    \"text\": { \"type\": \"mrkdwn\", \"text\": \"👀 *Pending Code Reviews:*\" }\n  }\n);\n\nfor (let i = 0; i < codeReviewLines.length; i += chunkSize) {\n  const chunkText = codeReviewLines.slice(i, i + chunkSize).join('\\n');\n  blocks.push({\n    \"type\": \"section\",\n    \"text\": { \"type\": \"mrkdwn\", \"text\": chunkText }\n  });\n}\n\nreturn [{\n  json: {\n    blocks: blocks\n  }\n}];"
      },
